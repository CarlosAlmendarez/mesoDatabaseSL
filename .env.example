# Copia este archivo como .env.local (local) y define las mismas variables en Vercel.
# Nunca subas los valores reales al repositorio.

# URL de conexión del proyecto Neon de UNIMES (Neon > Connect)
DATABASE_URL=
# Contraseña única para entrar a la demo
DEMO_PASSWORD=
# Texto aleatorio largo para firmar la cookie de sesión (ej. openssl rand -hex 32)
SESSION_SECRET=
